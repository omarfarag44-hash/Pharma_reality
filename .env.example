# ---------------------------------------------------------------------------
# PHARMA REALITY — environment configuration
# Copy to .env.local. With nothing set, the app runs in DEMO MODE using the
# deterministic fictional seed data. Missing variables never crash the app.
# ---------------------------------------------------------------------------

# auto (default) | demo | supabase | postgres
#   auto: Supabase if URL + anon key are set, else Postgres if DATABASE_URL is set, else demo.
PHARMA_DATA_MODE=auto

# --- Supabase (database + authentication) ----------------------------------
# Public values only. Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NEVER put the service-role key in a NEXT_PUBLIC_* variable. The web app does
# not use it at all; it is only needed if you run admin scripts on a server.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Direct PostgreSQL (server-only, optional) -------------------------------
# For self-hosting or local verification. Connects with the given role on the
# server; never exposed to the browser. No sign-in is required in this mode,
# so do not expose a postgres-mode deployment publicly.
DATABASE_URL=
